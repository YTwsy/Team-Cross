{
  "name": "@teamcross/agent-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "teamcross-agent-bridge": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./protocol": "./dist/protocol.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "probe:native": "node scripts/probe-native-capabilities.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.251"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=24"
  }
}
